# Environment Configuration
# If no API key is provided, the system seamlessly operates in built-in High-Fidelity Simulation Mode
# allowing offline evaluation and zero-setup demonstration!

# Google Gemini API Key (Optional)
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Preferred LLM Provider: 'auto', 'gemini', 'openai', or 'simulation'
DEFAULT_LLM_PROVIDER=auto

# Server configuration
PORT=5000
HOST=127.0.0.1
DEBUG=True
